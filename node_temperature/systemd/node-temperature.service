[Unit]
Description=node-temperature MQTT node
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/node-temperature
ExecStart=/opt/node-temperature/.venv/bin/python -m node_temperature.main --config /opt/node-temperature/config.ini
Restart=on-failure
RestartSec=5
User=renewvan
# Creates /var/lib/node-temperature owned by User=; set `state_dir` to it in
# config.ini so dashboard edits persist there.
StateDirectory=node-temperature

[Install]
WantedBy=multi-user.target
